# AeroGrid Intelligence Platform Environment Variables

# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration (PostgreSQL / Neon PostGIS)
DATABASE_URL=postgresql://user:password@ep-sample-pooler.ap-southeast-1.aws.neon.tech/aerogrid?sslmode=require

# Authentication & Security
JWT_SECRET=super-secret-jwt-key-replace-in-production-min-32-chars
JWT_EXPIRES_IN=24h
BCRYPT_SALT_ROUNDS=10

# CORS Whitelist (comma separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=500

